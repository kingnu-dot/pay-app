{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "支払い手段おすすめアプリのルール",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "points", "cards", "methods", "stores", "store_groups", "redemptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "$ref": "#/$defs/date" },
    "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
    "stores": { "type": "array", "items": { "$ref": "#/$defs/store" } },
    "store_groups": { "type": "array", "items": { "$ref": "#/$defs/store_group" } },
    "redemptions": { "type": "array", "items": { "$ref": "#/$defs/redemption" } }
  },
  "$defs": {
    "id": {
      "description": "識別子（英小文字・数字・アンダースコア）",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "text": {
      "description": "空でない文字列",
      "type": "string",
      "pattern": "\\S"
    },
    "date": {
      "description": "日付（YYYY-MM-DD。Asia/Tokyo の暦日）",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "date_or_null": {
      "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "id_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" }
    },
    "days_of_month": {
      "description": "対象となる日（1〜31）",
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1, "maximum": 31 }
    },
    "purchase_pay_type": {
      "description": "店頭・通販での払い方",
      "enum": ["google_pay_touch", "card_insert", "card_touch", "id_quicpay", "qr_pay", "transit_ic", "point_use", "online"]
    },
    "charge_pay_type": {
      "description": "チャージの種類（チャージ時の還元ルールに使う）",
      "enum": ["charge_transit_ic", "charge_qr_pay", "charge_emoney"]
    },
    "cap": {
      "description": "上限。amount は unit の単位での整数",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit", "period"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["point", "yen"] },
        "period": { "enum": ["txn", "day", "month", "year"] }
      }
    },
    "meta": {
      "description": "ルールの出典と有効期間（全ルールに必須）",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "last_verified", "valid_from", "valid_to", "cap"],
      "properties": {
        "source_url": { "type": "string", "pattern": "^https://\\S+$" },
        "last_verified": { "$ref": "#/$defs/date" },
        "valid_from": { "$ref": "#/$defs/date_or_null" },
        "valid_to": { "$ref": "#/$defs/date_or_null" },
        "cap": { "anyOf": [{ "$ref": "#/$defs/cap" }, { "type": "null" }] },
        "confidence": { "enum": ["verified", "unverified"] },
        "note": { "type": "string" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "value_milliyen"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "value_milliyen": {
          "description": "1 ポイントの評価額 [1/1000 円]。例：1.5 円 = 1500",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reward_rule": {
      "description": "還元ルール。計算順序：(1) 金額 ÷ unit_yen を rounding で整数にする (2) points_per_unit を掛ける (3) multiplier を掛ける。端数処理は必ず (1) で行い、掛け算はその後に行う",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "point_id", "unit_yen", "points_per_unit", "scope", "rounding", "stacking", "applies", "meta"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "point_id": { "$ref": "#/$defs/id" },
        "unit_yen": { "description": "計算単位 [円]", "type": "integer", "minimum": 1 },
        "points_per_unit": { "description": "計算単位あたりの付与量 [ポイント]", "type": "integer", "minimum": 0 },
        "scope": {
          "description": "per_txn：1回の利用ごとに端数処理（実付与量で比較） / monthly：月間合計に対して付与（期待値で比較）",
          "enum": ["per_txn", "monthly"]
        },
        "rounding": {
          "description": "floor：切り捨て / round：小数第1位を四捨五入",
          "enum": ["floor", "round"]
        },
        "multiplier": {
          "description": "端数処理の後に掛ける倍率（省略時 1）。例：100 円単位で四捨五入してから 2 倍 → 150 円は 2 × 2 = 4 ポイント（3 ポイントにはならない）",
          "type": "integer",
          "minimum": 1
        },
        "stacking": {
          "description": "base：基本の還元 / add：基本に上乗せ / replace_base：条件に合うとき基本を置き換える",
          "enum": ["base", "add", "replace_base"]
        },
        "applies": { "$ref": "#/$defs/applies" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "applies": {
      "description": "適用条件。指定した項目をすべて満たすときに適用する",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pay_types": {
          "description": "対象の払い方。省略時はすべての払い方（チャージは含まない）",
          "type": "array",
          "minItems": 1,
          "items": { "anyOf": [{ "$ref": "#/$defs/purchase_pay_type" }, { "$ref": "#/$defs/charge_pay_type" }] }
        },
        "store_group_ids": { "$ref": "#/$defs/id_list" },
        "store_ids": { "$ref": "#/$defs/id_list" },
        "exclude_store_ids": { "$ref": "#/$defs/id_list" },
        "days_of_month": { "$ref": "#/$defs/days_of_month" }
      }
    },
    "annual_target": {
      "description": "年間利用額の目標",
      "type": "object",
      "additionalProperties": false,
      "required": ["target_yen", "period_start_month", "period_start_day", "meta"],
      "properties": {
        "target_yen": { "type": "integer", "minimum": 1 },
        "period_start_month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "period_start_day": { "type": "integer", "minimum": 1, "maximum": 28 },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rewards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "rewards": { "type": "array", "items": { "$ref": "#/$defs/reward_rule" } },
        "annual_target": { "$ref": "#/$defs/annual_target" }
      }
    },
    "method_warning": {
      "description": "注意事項。amount_gt_yen を指定すると、金額がそれを超えたときだけ表示する",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "amount_gt_yen": { "type": "integer", "minimum": 0 },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "funding": {
      "description": "チャージ型の支払い手段のチャージ元。card_id が null のときはカード以外（銀行口座など）",
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "pay_type"],
      "properties": {
        "card_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "pay_type": { "$ref": "#/$defs/charge_pay_type" },
        "note": { "type": "string" }
      }
    },
    "method": {
      "description": "支払い手段（カード × 払い方）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "pay_type", "card_id", "earns_points", "counts_toward_annual"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "pay_type": { "$ref": "#/$defs/purchase_pay_type" },
        "card_id": {
          "description": "直接払うカード。チャージ型の手段では null",
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "funding": { "$ref": "#/$defs/funding" },
        "rewards": {
          "description": "手段そのものの還元（利用時に付くポイントなど）",
          "type": "array",
          "items": { "$ref": "#/$defs/reward_rule" }
        },
        "earns_points": { "type": "boolean" },
        "counts_toward_annual": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/method_warning" } }
      }
    },
    "loyalty": {
      "description": "会計時に提示するポイントカード",
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "note": { "type": "string" }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "loyalty": { "type": "array", "items": { "$ref": "#/$defs/loyalty" } },
        "unusable_pay_types": { "type": "array", "items": { "$ref": "#/$defs/purchase_pay_type" } },
        "unusable_method_ids": { "$ref": "#/$defs/id_list" },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "store_group": {
      "description": "店舗の集合（公式の対象店一覧など）。還元ルールの適用条件から参照する",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "store_ids", "meta"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "store_ids": { "$ref": "#/$defs/id_list" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "redemption": {
      "description": "ポイント利用の案内（順位には入れず、条件に合う日に最上部へ表示する）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "point_id", "store_ids", "value_milliyen", "text", "meta"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "point_id": { "$ref": "#/$defs/id" },
        "store_ids": { "$ref": "#/$defs/id_list" },
        "days_of_month": { "$ref": "#/$defs/days_of_month" },
        "value_milliyen": {
          "description": "この条件で使うときの 1 ポイントの価値 [1/1000 円]",
          "type": "integer",
          "minimum": 0
        },
        "text": { "$ref": "#/$defs/text" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  }
}
